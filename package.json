{
  "name": "fypgen",
  "version": "0.1.0",
  "description": "Free forever, local Final Year Project report generator for Nigerian students",
  "type": "module",
  "bin": {
    "fypgen": "bin/fypgen.js"
  },
  "files": [
    "bin",
    "dist-server",
    "shared/constants.ts",
    "web/dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && npm run build:server",
    "dev": "npm --prefix web run dev",
    "dev:api": "npm run build:server && PORT=3000 FYPGEN_NO_OPEN=1 node bin/fypgen.js",
    "start": "node bin/fypgen.js",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "jszip": "^3.10.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "undici": "^8.10.2"
  }
}
