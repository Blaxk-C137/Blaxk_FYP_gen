{
  "name": "fypgen",
  "version": "0.1.0",
  "description": "Free forever, local Final Year Project report generator for Nigerian students",
  "type": "module",
  "bin": { "fypgen": "bin/fypgen.js" },
  "files": ["bin", "server", "shared", "web/dist", "README.md"],
  "scripts": {
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && npm run build:server",
    "dev": "npm --prefix web run dev",
    "start": "node bin/fypgen.js",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "jszip": "^3.10.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
