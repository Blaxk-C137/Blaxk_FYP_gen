{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["shared/**/*.ts", "server/**/*.ts"],
  "exclude": ["web", "dist-server", "node_modules", "**/*.test.ts"]
}
